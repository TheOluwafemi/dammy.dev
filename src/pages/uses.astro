---
import Base from '../layouts/Base.astro'
import SectionHead from '../components/SectionHead.astro'

// Hardware, editor and terminal were read off the machine this site was built on.
// TODO(you): correct anything that is out of date, and add what only you know
// (keyboard, monitor, fonts, theme).
const groups = [
  {
    title: 'Hardware',
    items: [['Laptop', 'MacBook Air, Apple M2, 16 GB']],
  },
  {
    title: 'Editor and terminal',
    items: [
      ['Editor', 'Visual Studio Code'],
      ['Terminal', 'iTerm2, zsh'],
      ['AI', 'Claude Code'],
    ],
  },
  {
    title: 'Tooling',
    items: [
      ['Runtime', 'Node.js 22, managed with nvm'],
      ['Packages', 'pnpm, with Turborepo and Changesets for monorepos'],
      ['Local infra', 'Docker'],
      ['Browsers', 'Chrome'],
    ],
  },
  {
    title: 'What I build with',
    items: [
      ['Language', 'TypeScript'],
      ['Front end', 'Vue and Nuxt, Astro for content sites'],
      ['Server', 'Hono on Cloudflare Workers, with KV for storage'],
      ['Standards', 'OpenFeature and OFREP'],
      ['Checks', 'Prettier, publint, Are the Types Wrong, and a conformance suite for every storage adapter'],
    ],
  },
]
---

<Base
  title="Uses — Damilola Oluwafemi"
  description="The hardware, editor, tooling and stack Damilola Oluwafemi uses to build software."
  path="/uses"
>
  <div class="container page">
    <SectionHead left="What I work with" name="Uses" />
    <h1 class="page-title">Uses</h1>

    <div class="sheet groups">
      {groups.map((g) => (
        <section class="group" aria-labelledby={`uses-${g.title}`}>
          <h2 id={`uses-${g.title}`}>{g.title}</h2>
          <dl>
            {g.items.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  .groups {
    display: grid;
    gap: clamp(28px, 5vh, 48px);
  }
  h2 {
    margin-block-end: 12px;
    font: 800 clamp(22px, 2.4vw, 30px) / 1.1 var(--font-display);
    letter-spacing: -0.025em;
  }
  dl {
    border-block-start: 1.5px solid var(--ink);
  }
  dl > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px 32px;
    padding-block: 14px;
    border-block-end: 1px solid var(--rule);
  }
  @media (min-width: 40rem) {
    dl > div {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }
  dt {
    font: 500 12px / 1.5 var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--paper-ink-muted);
  }
  dd {
    margin: 0;
    font: 400 16px / 1.55 var(--font-body);
  }
</style>
