---
import Base from '../layouts/Base.astro'
import Hero from '../sections/Hero.astro'
import Conditions from '../sections/Conditions.astro'
import Now from '../sections/Now.astro'
import Work from '../sections/Work.astro'
import Changelog from '../sections/Changelog.astro'
import Writing from '../sections/Writing.astro'
import Contact from '../sections/Contact.astro'
---

<Base
  sky="home"
  title="Damilola Oluwafemi — engineer"
  description="Damilola Oluwafemi is a software engineer in the UK building developer tools and the products around them. Creator of Flaghoist, open-source OpenFeature-native feature flags."
>
  <!-- The old site used /#about and /#projects. Fragments never reach the server, so redirect here. -->
  <script is:inline>
    ;(() => {
      const moved = { '#about': '/about', '#projects': '/#work' }
      const to = moved[location.hash]
      if (to) location.replace(to)
    })()
  </script>
  <Hero />
  <Conditions />
  <Now />
  <Work />
  <Changelog />
  <Writing />
  <Contact />
</Base>
