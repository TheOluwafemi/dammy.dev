---
import Base from '../layouts/Base.astro'
import CopyEmail from '../components/CopyEmail.astro'
import NpmPackages from '../components/NpmPackages.astro'
import { site, now } from '../data/site'
import { getFeatured, hrefFor, isExternal, kindLabel, years } from '../lib/work'
import { getPosts } from '../lib/writing'
import { getPackages, summarise, isFlaghoist, roughly } from '../lib/npm'

const featured = await getFeatured()
const posts = (await getPosts()).slice(0, 3)
const packages = await getPackages()
const all = summarise(packages)
const flaghoist = summarise(packages.filter(isFlaghoist))

// Stats are computed from live npm data, never hard-coded. Omitted if npm was unreachable.
const statsFor = (npm?: string | string[]) =>
  npm === 'flaghoist' && flaghoist.downloads !== null
    ? `${flaghoist.count} packages · about ${roughly(flaghoist.downloads)} downloads last month`
    : undefined

const openSourceIntro =
  all.downloads !== null
    ? `${all.count} packages on npm, about ${roughly(all.downloads)} downloads a month. Most of them exist because I needed them for something else first.`
    : 'Packages on npm. Most of them exist because I needed them for something else first.'
---

<Base
  title="Damilola Oluwafemi — engineer"
  description="Damilola Oluwafemi is a software engineer in the UK building developer tools and the products around them. Creator of Flaghoist, open-source OpenFeature-native feature flags."
>
  <div class="hero container">
    <h1>{site.name}</h1>
    <p class="statement">I build developer tools and the products around them.</p>
    <p class="detail">
      Eight years across banking, fintech and crypto. Right now I'm building Flaghoist: open-source feature flags you host yourself, running on the edge for nothing.
    </p>
    <p class="actions">
      <a class="btn btn-primary" href="/work">Work</a>
      <a class="btn" href="https://flaghoist.dev">Flaghoist</a>
    </p>
    <p class="eyebrow">{site.location}</p>
  </div>

  <div class="container blocks">
    <section class="section" aria-labelledby="now-h">
      <h2 id="now-h">Now</h2>
      <p class="eyebrow">{now.date}</p>
      <p class="prose">{now.text}</p>
    </section>

    <section class="section" aria-labelledby="work-h">
      <h2 id="work-h">Selected work</h2>
      <ul role="list" class="work">
        {featured.map((w) => (
          <li class="work-item" data-reveal>
            <h3>
              <a
                class="work-link"
                href={hrefFor(w)}
                style={w.data.caseStudy ? `view-transition-name: work-${w.id}` : undefined}
              >{w.data.title}</a>
            </h3>
            <p class="eyebrow">{kindLabel(w)} · {years(w)}</p>
            <p>{w.data.summary}</p>
            {statsFor(w.data.npm) && <p class="stat">{statsFor(w.data.npm)}</p>}
            <svg class="arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              {isExternal(w) ? <path d="M4 12 12 4M5.5 4H12v6.5" /> : <path d="M3 8h10M9 4l4 4-4 4" />}
            </svg>
          </li>
        ))}
      </ul>
    </section>

    <section class="section" aria-labelledby="oss-h">
      <h2 id="oss-h">Open source</h2>
      <p class="prose intro">{openSourceIntro}</p>
      <div data-reveal><NpmPackages packages={packages} /></div>
    </section>

    {posts.length > 0 && (
      <section class="section" aria-labelledby="writing-h">
        <h2 id="writing-h">Writing</h2>
        <ul role="list" class="work">
          {posts.map((p) => (
            <li class="work-item" data-reveal>
              <h3><a class="work-link" href={`/writing/${p.id}`} style={`view-transition-name: post-${p.id}`}>{p.data.title}</a></h3>
              <p>{p.data.summary}</p>
              <svg class="arrow" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
            </li>
          ))}
        </ul>
        <p class="more-link"><a class="link" href="/writing">All writing</a></p>
      </section>
    )}

    <section class="section" aria-labelledby="contact-h">
      <h2 id="contact-h">Get in touch</h2>
      <p class="prose intro">Want to say hello, work together, or build something? I read everything.</p>
      <CopyEmail />
    </section>
  </div>
</Base>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-12);
    display: grid;
    gap: var(--space-6);
    justify-items: start;
  }
  h1 {
    font-size: var(--text-display);
    color: var(--accent);
    letter-spacing: 0.01em;
  }
  .statement {
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.25;
    max-inline-size: 28ch;
  }
  .detail,
  .prose {
    max-inline-size: var(--measure);
    color: var(--fg-muted);
  }
  .intro {
    margin-block-end: var(--space-6);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* Hero entrance (plan 3.4). Content ships visible: keyframes only define `from`,
     `backwards` fill applies it during the delay. Never opacity:0 in the markup. */
  .hero > * {
    animation: rise var(--dur-base) var(--ease-out) backwards;
  }
  .hero > :nth-child(2) {
    animation-delay: 40ms;
  }
  .hero > :nth-child(3) {
    animation-delay: 80ms;
  }
  .hero > :nth-child(4) {
    animation-delay: 120ms;
  }
  .hero > :nth-child(5) {
    animation-delay: 160ms;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* Selected work: whole row is one link (stretched title link), no nested interactives. */
  .work {
    display: grid;
    border-block-start: 1px solid var(--border);
  }
  .work-item {
    position: relative;
    display: grid;
    gap: var(--space-1);
    padding: var(--space-6) var(--space-8) var(--space-6) 0;
    border-block-end: 1px solid var(--border);
  }
  .work-item h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }
  .work-item p:not(.eyebrow):not(.stat) {
    max-inline-size: var(--measure);
    color: var(--fg-muted);
  }
  .work-link {
    text-decoration: none;
  }
  .work-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .more-link {
    margin-block-start: var(--space-6);
  }
  .stat {
    font-size: var(--text-sm);
    color: var(--accent);
  }
  .arrow {
    position: absolute;
    inset-block-start: var(--space-6);
    inset-inline-end: 0;
    color: var(--fg-muted);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .work-item:hover .arrow {
      transform: translate(2px, -2px);
      color: var(--accent);
    }
  }
</style>
