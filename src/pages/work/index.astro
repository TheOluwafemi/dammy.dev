---
import Base from '../../layouts/Base.astro'
import SectionHead from '../../components/SectionHead.astro'
import WorkBoard from '../../components/WorkBoard.astro'
import NpmPackages from '../../components/NpmPackages.astro'
import { getWork } from '../../lib/work'
import { getPackages, roughly, summarise } from '../../lib/npm'

const work = await getWork()
const packages = await getPackages()
const all = summarise(packages)
---

<Base
  title="Work · Damilola Oluwafemi"
  description="Products, open-source packages and experiments by Damilola Oluwafemi: Flaghoist, dsl-query-builder, and earlier work in fintech and crypto."
  path="/work"
>
  <div class="container page">
    <SectionHead left="Everything, newest first" name="Work" />
    <h1 class="page-title">All the work</h1>
    <WorkBoard rows={work} />

    <section class="sheet oss" aria-labelledby="oss-title">
      <h2 id="oss-title">Open source on npm</h2>
      <p class="intro">
        {all.downloads === null ? `${all.count} packages.` : `${all.count} packages, about ${roughly(all.downloads)} downloads a month.`} Most of them exist because I needed them for something else first.
      </p>
      <NpmPackages packages={packages} />
    </section>
  </div>
</Base>

<style>
  .oss {
    margin-block-start: clamp(48px, 10vh, 120px);
  }
  h2 {
    font: 800 clamp(26px, 3vw, 38px) / 1.05 var(--font-display);
    letter-spacing: -0.03em;
  }
  .intro {
    max-inline-size: 60ch;
    margin-block: 12px 20px;
    font: 400 16px / 1.6 var(--font-body);
  }
</style>
