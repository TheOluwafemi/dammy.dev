---
import { render } from 'astro:content'
import Article from '../../layouts/Article.astro'
import { getWork, kindLabel, years, type Work } from '../../lib/work'
import { getPackages, summarise, isFlaghoist, roughly } from '../../lib/npm'

export async function getStaticPaths() {
  const work = await getWork()
  return work.filter((w) => w.data.caseStudy).map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props as { entry: Work }
const { Content } = await render(entry)
const d = entry.data

// Live npm numbers, so the case study never carries a stale figure.
const metrics = [...d.metrics]
const npm = d.npm
if (npm) {
  const all = await getPackages()
  const mine = npm === 'flaghoist' ? all.filter(isFlaghoist) : all.filter((p) => npm.includes(p.name))
  const s = summarise(mine)
  metrics.push({ label: 'Packages on npm', value: String(s.count) })
  if (s.downloads !== null) metrics.push({ label: 'Downloads, last month', value: `about ${roughly(s.downloads)}` })
}
---

<Article
  title={d.title}
  summary={d.summary}
  eyebrow={`${kindLabel(entry)} · ${years(entry)}${d.role ? ` · ${d.role}` : ''}`}
  back={{ href: '/work', label: 'All work' }}
  path={`/work/${entry.id}`}
  image={{ src: `/og/${entry.id}.png`, width: 1200, height: 630, alt: `${d.title}: ${d.summary}` }}
  metrics={metrics}
  links={d.links}
>
  <Content />
</Article>
