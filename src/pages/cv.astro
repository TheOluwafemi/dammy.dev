---
// Print source for /cv.pdf. Generated by `npm run cv`; not linked from the nav and not indexed.
import Base from '../layouts/Base.astro'
import { experience, education, years } from '../data/experience'
import { linkedin, site, socials } from '../data/site'

const link = (s: string) => s.replace(/^https?:\/\/(www\.)?/, '')
const contact = [
  site.email,
  'dammy.dev',
  link(socials[0].href),
  link(linkedin),
  link(socials[1].href),
]

const openSource = [
  ['Flaghoist', 'Creator and sole maintainer, 2026–present', 'Open-source, OpenFeature-native feature flags that run on Cloudflare Workers. 14 npm packages in a TypeScript monorepo: an evaluation engine, a Hono server, storage adapters for KV, Redis, Postgres and SQLite, a CLI, an MCP server and Vue bindings. Verified against a live server from seven languages.'],
  ['dsl-query-builder', 'Author, 2025', 'Zero-dependency TypeScript query builder for OpenSearch and Elasticsearch DSL, under 15 KB.'],
  ['vue-form-manager', 'Author, 2025', 'Form validation for Vue 3 from plain configuration objects, with Zod and full type safety.'],
]

const skills = [
  ['Languages', 'TypeScript, JavaScript (ES6+), HTML5, CSS/SCSS'],
  ['Frameworks', 'Vue, Nuxt, React, Next, Angular, Astro, Hono'],
  ['Infrastructure', 'Cloudflare Workers and KV, GitHub Actions, Docker, Netlify, Vercel'],
  ['Standards and tooling', 'OpenFeature and OFREP, REST, GraphQL, pnpm, Turborepo, Changesets'],
  ['Content and growth', 'Storyblok, Prismic, Contentful, HubSpot, Segment, Google Analytics'],
  ['Practice', 'Accessibility, performance, state management (Vuex, Pinia, Redux), Scrum and Kanban'],
]
---

<Base title="CV · Damilola Oluwafemi" description="Curriculum vitae of Damilola Oluwafemi, software engineer." path="/cv" noindex>
  <div class="cv">
    <header>
      <h1>Damilola Oluwafemi</h1>
      <p class="title">Software engineer</p>
      <p class="contact">{contact.join('  ·  ')}</p>
    </header>

    <p class="summary">
      Software engineer with eight years across banking, fintech and crypto, now building developer tools. Creator of Flaghoist, open-source feature flags on the edge.
    </p>

    <section>
      <h2>Open source</h2>
      {openSource.map(([name, role, text]) => (
        <div class="entry">
          <div class="head"><strong>{name}</strong><span>{role}</span></div>
          <p>{text}</p>
        </div>
      ))}
    </section>

    <section>
      <h2>Experience</h2>
      {experience.map((r) => (
        <div class="entry">
          <div class="head"><strong>{r.role}, {r.org}{r.orgNote ? ` (${r.orgNote})` : ''}</strong><span>{years(r)}</span></div>
          <p class="where">{r.where}</p>
          <ul>{r.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
      ))}
    </section>

    <section>
      <h2>Education</h2>
      <div class="entry">
        <div class="head"><strong>{education.degree}</strong><span>{education.where}</span></div>
        <p>{education.school}</p>
      </div>
    </section>

    <section>
      <h2>Skills</h2>
      <dl>
        {skills.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </section>
  </div>
</Base>

<style is:global>
  @page {
    size: A4;
    margin: 14mm 16mm;
  }
  /* The PDF is always light and chrome-free, whatever theme the page was opened in. */
  .cv {
    --cv-fg: #14141f;
    --cv-muted: #555568;
    --cv-rule: #cfcfd8;
    --cv-accent: #3527d6;
    max-inline-size: 190mm;
    margin-inline: auto;
    padding: 32px var(--gutter);
    color: var(--cv-fg);
    background: #fff;
    font-size: 10pt;
    line-height: 1.45;
  }
  .cv h1 {
    font-size: 26pt;
    color: var(--cv-accent);
  }
  .cv .title {
    font-size: 13pt;
    font-weight: 500;
  }
  .cv .contact,
  .cv .where {
    color: var(--cv-muted);
  }
  .cv .summary {
    margin-block: 4mm 2mm;
  }
  .cv h2 {
    margin-block: 5mm 2mm;
    padding-block-end: 1mm;
    border-block-end: 1px solid var(--cv-rule);
    font-family: var(--font-body);
    font-size: 10pt;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cv-accent);
  }
  .cv .entry {
    margin-block-end: 3mm;
    break-inside: avoid;
  }
  .cv .head {
    display: flex;
    justify-content: space-between;
    gap: 6mm;
  }
  .cv .head span {
    color: var(--cv-muted);
    white-space: nowrap;
  }
  .cv ul {
    margin: 1mm 0 0;
    padding-inline-start: 5mm;
  }
  .cv dl > div {
    display: grid;
    grid-template-columns: 34mm minmax(0, 1fr);
    gap: 4mm;
  }
  .cv dt {
    font-weight: 500;
  }
  .cv dd {
    margin: 0;
  }
  @media print {
    :root {
      color-scheme: light;
    }
    html,
    body {
      background: #fff !important;
    }
    .site-header,
    .site-footer,
    .skip-link {
      display: none !important;
    }
    .cv {
      padding: 0;
      max-inline-size: none;
    }
  }
</style>
