---
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { getPosts, formatDate, type Post } from '../../lib/writing'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props as { entry: Post }
const { Content } = await render(entry)
const d = entry.data
const url = `https://dammy.dev/writing/${entry.id}`

const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.summary,
  datePublished: d.published.toISOString(),
  ...(d.updated && { dateModified: d.updated.toISOString() }),
  author: { '@type': 'Person', name: 'Damilola Oluwafemi', url: 'https://dammy.dev' },
  mainEntityOfPage: url,
}
---

<Base
  title={`${d.title} — Damilola Oluwafemi`}
  description={d.summary}
  path={`/writing/${entry.id}`}
  type="article"
  jsonLd={article}
>
  <article class="container post">
    <a class="back link" href="/writing">All writing</a>
    <header>
      <p class="eyebrow">
        <time datetime={d.published.toISOString()}>{formatDate(d.published)}</time>
        {d.updated && <> · Updated <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time></>}
      </p>
      <h1 style={`view-transition-name: post-${entry.id}`}>{d.title}</h1>
      <p class="summary">{d.summary}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post {
    padding-block: var(--space-8) var(--space-12);
    max-inline-size: calc(var(--measure) + var(--gutter) * 2);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }
  .back {
    justify-self: start;
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }
  header {
    display: grid;
    gap: var(--space-3);
  }
  h1 {
    font-size: clamp(2rem, 1.4rem + 3vw, 3.5rem);
    color: var(--accent);
  }
  .summary {
    font-size: var(--text-lg);
    line-height: 1.4;
    color: var(--fg-muted);
  }
</style>
