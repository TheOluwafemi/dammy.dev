---
import { render } from 'astro:content'
import Article from '../../layouts/Article.astro'
import { getPosts, formatDate, type Post } from '../../lib/writing'

export async function getStaticPaths() {
  const posts = await getPosts()
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props as { entry: Post }
const { Content } = await render(entry)
const d = entry.data
const url = `https://dammy.dev/writing/${entry.id}`

const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.summary,
  datePublished: d.published.toISOString(),
  ...(d.updated && { dateModified: d.updated.toISOString() }),
  author: { '@type': 'Person', name: 'Damilola Oluwafemi', url: 'https://dammy.dev' },
  mainEntityOfPage: url,
}
const eyebrow = d.updated ? `${formatDate(d.published)} · updated ${formatDate(d.updated)}` : formatDate(d.published)
---

<Article
  title={d.title}
  summary={d.summary}
  eyebrow={eyebrow}
  back={{ href: '/writing', label: 'All writing' }}
  path={`/writing/${entry.id}`}
  jsonLd={article}
>
  <Content />
</Article>
