---
import Base from '../../layouts/Base.astro'
import SectionHead from '../../components/SectionHead.astro'
import PostCards from '../../components/PostCards.astro'
import { getPosts } from '../../lib/writing'
import { elsewhere } from '../../data/site'

const posts = await getPosts()
---

<Base
  title="Writing — Damilola Oluwafemi"
  description="Build notes from Flaghoist and other projects: protocols, rollouts and release pipelines, plus older articles published elsewhere."
  path="/writing"
>
  <div class="container page">
    <SectionHead left="Notes from building things" name="Writing" />
    <h1 class="page-title">Writing</h1>
    <PostCards posts={posts} />

    <section class="sheet elsewhere" aria-labelledby="elsewhere-title">
      <h2 id="elsewhere-title">Published elsewhere</h2>
      <ul role="list">
        {elsewhere.map((e) => (
          <li>
            <a href={e.href} rel="external">{e.title}</a>
            <span class="site">{e.site}</span>
            <p>{e.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .elsewhere {
    margin-block-start: clamp(48px, 10vh, 120px);
  }
  h2 {
    margin-block-end: 16px;
    font: 800 clamp(26px, 3vw, 38px) / 1.05 var(--font-display);
    letter-spacing: -0.03em;
  }
  ul {
    border-block-start: 1.5px solid var(--ink);
  }
  li {
    display: grid;
    gap: 6px;
    padding-block: 18px;
    border-block-end: 1px solid var(--rule);
  }
  li a {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
    font: 800 clamp(20px, 2vw, 24px) / 1.15 var(--font-display);
    letter-spacing: -0.02em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .site {
    font: 500 11px / 1.3 var(--font-mono);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--paper-ink-muted);
  }
  li p {
    max-inline-size: 60ch;
    font: 400 15px / 1.55 var(--font-body);
  }
</style>
