---
import Base from '../layouts/Base.astro'
import SectionHead from '../components/SectionHead.astro'
import { experience, education, years } from '../data/experience'
import { site } from '../data/site'
---

<Base
  title="About — Damilola Oluwafemi"
  description="Damilola Oluwafemi is a software engineer in the UK. Eight years across banking, fintech and crypto, now building developer tools. His career, how he works, and what he does outside work."
  path="/about"
>
  <div class="container page">
    <SectionHead left={site.location} name="About" />
    <h1 class="page-title">About</h1>
    <p class="lead">
      I build developer tools and the products around them. Eight years on the front end of banking, fintech and a crypto exchange, and lately lower down the stack.
    </p>

    <div class="sheet">
      <div class="prose">
        <p>
          I started on the front end at a bank in Lagos and have spent most of my career on products where money moves: banking, fintech and a crypto exchange. Lately I've been working on infrastructure that other engineers build on. <a href="/work/flaghoist">Flaghoist</a> is the current example.
        </p>

        <h2>How I work</h2>
        <p>I like small interfaces I can verify. If a claim matters, I test it against reality before I make it, and I write down where a project loses as plainly as where it wins.</p>
        <p>I would rather ship something narrow that is correct than something broad that is nearly right, and I try to leave the reasons in the code and the repository, not in my head.</p>

        <h2>Experience</h2>
      </div>
      <ol role="list" class="ladder">
        {experience.map((r) => (
          <li>
            <p class="when">{years(r)}</p>
            <div>
              <h3>{r.url ? <a href={r.url}>{r.org}</a> : r.org}</h3>
              <p class="role">{r.role}{r.orgNote ? `, ${r.orgNote}` : ''} · {r.where}</p>
              <p class="highlight">{r.highlight}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="cv"><a class="btn btn-outline" href="/cv.pdf">Download my CV (PDF)</a></p>

      <div class="prose">
        <h2>Education</h2>
        <p><strong>{education.degree}</strong><br />{education.school}, {education.where}</p>

        <h2>Outside work</h2>
        <p>My hobbies take up a large chunk of my leisure. I love to travel, play FC25, listen to delightful music, or take evening strolls.</p>
      </div>
    </div>
  </div>
</Base>

<style>
  .lead {
    max-inline-size: 30ch;
    margin-block-end: clamp(28px, 5vh, 56px);
    font: var(--t-writing-lead);
    letter-spacing: var(--ls-writing-lead);
    text-shadow: var(--glow);
    text-wrap: balance;
  }
  .ladder {
    margin-block-start: 20px;
    border-block-start: 1.5px solid var(--ink);
  }
  .ladder li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 4px 32px;
    padding-block: 22px;
    border-block-end: 1px solid var(--rule);
  }
  @media (min-width: 48rem) {
    .ladder li {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }
  .when,
  .role {
    font: 500 12px / 1.4 var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--paper-ink-muted);
  }
  .ladder h3 {
    font: 800 clamp(22px, 2.2vw, 28px) / 1.1 var(--font-display);
    letter-spacing: -0.025em;
  }
  .ladder h3 a {
    text-decoration: none;
  }
  .role {
    margin-block-start: 6px;
  }
  .highlight {
    max-inline-size: 60ch;
    margin-block-start: 8px;
    font: 400 16px / 1.6 var(--font-body);
  }
  .cv {
    margin-block: 28px 8px;
  }
</style>
