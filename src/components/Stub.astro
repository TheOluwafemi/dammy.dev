---
// Temporary placeholder so the nav has somewhere to go. Replaced in plan Phase 3/4.
interface Props {
  title: string
  phase: string
}
const { title, phase } = Astro.props
---

<div class="container stub">
  <h1>{title}</h1>
  <p>Coming soon (build plan, {phase}).</p>
</div>

<style>
  .stub {
    padding-block: var(--space-16);
    display: grid;
    gap: var(--space-4);
  }
  h1 {
    font-size: var(--text-display);
    color: var(--accent);
  }
  p {
    color: var(--fg-muted);
  }
</style>
