---
// Theme toggle. The initial theme is set by the blocking script in Base.astro's
// <head>; this only handles changes. Circular reveal from the button (plan §3.7 #4).
---

<button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">
  <span class="visually-hidden">Dark theme</span>
  <svg class="icon icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg class="icon icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    padding: 0;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg);
    cursor: pointer;
    transition:
      transform var(--dur-press) var(--ease-out),
      border-color var(--dur-fast) var(--ease);
  }
  .theme-toggle:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .theme-toggle:hover {
      border-color: var(--fg-muted);
    }
  }
  .icon {
    grid-area: 1 / 1;
  }
  /* Show the icon for the theme you would switch TO */
  .icon-moon {
    display: none;
  }
  :global(:root[data-theme='light']) .icon-sun {
    display: none;
  }
  :global(:root[data-theme='light']) .icon-moon {
    display: block;
  }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .icon-sun {
      display: none;
    }
    :global(:root:not([data-theme])) .icon-moon {
      display: block;
    }
  }
</style>

<script>
  const root = document.documentElement
  const COLORS = { light: '#f6f5f2', dark: '#0f0f1b' } as const
  type Theme = keyof typeof COLORS

  function apply(theme: Theme) {
    root.dataset.theme = theme
    try {
      localStorage.setItem('theme', theme)
    } catch {}
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', COLORS[theme])
    sync()
  }

  function sync() {
    const dark = root.dataset.theme === 'dark'
    document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.setAttribute('aria-pressed', String(dark)))
  }

  async function toggle(button: HTMLElement) {
    const next: Theme = root.dataset.theme === 'dark' ? 'light' : 'dark'
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
    if (!document.startViewTransition || reduce) return apply(next)

    const r = button.getBoundingClientRect()
    const x = r.left + r.width / 2
    const y = r.top + r.height / 2
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))

    root.dataset.vt = 'theme'
    const t = document.startViewTransition(() => apply(next))
    // A skipped or aborted transition (e.g. hidden tab) rejects these; the theme still applied.
    t.updateCallbackDone.catch(() => {})
    t.finished.catch(() => {})
    try {
      await t.ready
      root.animate(
        { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        { duration: 300, easing: 'cubic-bezier(0.77, 0, 0.175, 1)', pseudoElement: '::view-transition-new(root)' },
      )
      await t.finished
    } catch {}
    delete root.dataset.vt
  }

  // Delegated, so it survives ClientRouter page swaps.
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-theme-toggle]')
    if (b) toggle(b)
  })
  document.addEventListener('astro:after-swap', sync)
  sync()
</script>
