---
import { nav } from '../data/site'
---

<!-- Spec §4.2: sticky, logo left, nav right. Below 480px the nav takes its own row under the logo; no menu button. -->
<header class="site-header">
  <div class="container bar">
    <a class="logo" href="/">dammy.dev</a>
    <nav class="nav" aria-label="Main">
      {nav.map((l) => <a class="nav-link" href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 10;
    background: var(--panel);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-block-end: 1px solid var(--rule);
    transition:
      background-color var(--dur-skin),
      border-color var(--dur-skin);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-block: 12px;
  }
  .logo {
    flex: none;
    display: flex;
    align-items: center;
    min-block-size: var(--tap);
    font: var(--t-logo);
    letter-spacing: var(--ls-logo);
    text-decoration: none;
  }
  /* One row at every width (fixes reference §3.3): the nav scrolls instead of wrapping. */
  .nav {
    display: flex;
    gap: 4px;
    min-inline-size: 0;
    margin-inline-start: auto;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav::-webkit-scrollbar {
    display: none;
  }
  /* Phones: four links don't fit beside the logo at a usable tap size, so they get a row of
     their own, spread edge to edge. --header-h (tokens.css) matches this height. */
  @media (max-width: 479px) {
    .bar {
      flex-wrap: wrap;
      gap: 0;
      padding-block: 6px 2px;
    }
    .nav {
      flex-basis: calc(100% + 24px);
      justify-content: space-between;
      margin-inline: -12px;
    }
  }
  .nav-link {
    display: flex;
    align-items: center;
    min-block-size: var(--tap);
    padding-inline: 12px;
    border-radius: var(--radius-pill);
    font: var(--t-nav);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur-lift);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      background: rgba(127, 127, 127, 0.16);
    }
  }
</style>
