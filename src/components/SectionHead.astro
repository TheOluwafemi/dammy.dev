---
// The row every section opens with: an optional label, a rule, then NAME. The spec put the
// section's time and phase on the left; home leaves it out and lets the sky say it.
// When the section has no big heading of its own, the name is the section's <h2>.
interface Props {
  /** Left of the rule, e.g. "United Kingdom". */
  left?: string
  name: string
  /** id for the <h2>, when the name is the section's heading. */
  headingId?: string
}
const { left, name, headingId } = Astro.props
---

<div class="section-head">
  {left && <span aria-hidden="true">{left}</span>}
  <span class="line" aria-hidden="true"></span>
  {headingId ? <h2 id={headingId} class="name">{name}</h2> : <span class="name" aria-hidden="true">{name}</span>}
</div>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font: 500 11.5px / 1.3 var(--font-mono);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
  }
  .line {
    flex: 1;
    block-size: 1px;
    background: var(--rule);
    transition: background-color var(--dur-skin);
  }
  .name {
    font: inherit;
    letter-spacing: inherit;
  }
</style>
