---
// Case studies and posts: title and summary over the lite sky, the text on a paper sheet.
import Base from './Base.astro'

interface Props {
  title: string
  summary: string
  /** Label row: e.g. "Open source · 2026– · Creator and sole maintainer". */
  eyebrow: string
  back: { href: string; label: string }
  path: string
  image?: { src: string; width: number; height: number; alt: string }
  jsonLd?: Record<string, unknown>
  metrics?: { label: string; value: string }[]
  links?: { label: string; href: string }[]
}
const { title, summary, eyebrow, back, path, image, jsonLd, metrics = [], links = [] } = Astro.props
---

<Base title={`${title} — Damilola Oluwafemi`} description={summary} path={path} type="article" image={image} jsonLd={jsonLd}>
  <article class="container page article">
    <div class="head-row">
      <a class="back" href={back.href}>
        <svg viewBox="0 0 14 10" width="14" height="10" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 5H1.5M5 1 1 5l4 4" /></svg>
        {back.label}
      </a>
      <span class="rule" aria-hidden="true"></span>
      <span class="eyebrow">{eyebrow}</span>
    </div>

    <header class="intro">
      <h1 class="title">{title}</h1>
      <p class="summary">{summary}</p>
    </header>

    {metrics.length > 0 && (
      <dl class="metrics">
        {metrics.map((m) => (
          <div class="metric">
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="sheet">
      <div class="prose"><slot /></div>
    </div>

    {links.length > 0 && (
      <ul role="list" class="links">
        {links.map((l, i) => (
          <li><a class:list={['btn', i === 0 ? 'btn-primary' : 'btn-outline']} href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    )}
  </article>
</Base>

<style>
  .article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(24px, 4vh, 40px);
  }
  .head-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-block-size: var(--tap);
    font: 600 14px / 1 var(--font-body);
    text-decoration: none;
  }
  .rule {
    flex: 1;
    min-inline-size: 24px;
    block-size: 1px;
    background: var(--rule);
  }
  .intro {
    display: grid;
    gap: 18px;
  }
  .title {
    max-inline-size: 18ch;
    font: var(--t-work-row);
    letter-spacing: var(--ls-work-row);
    text-shadow: var(--glow);
    text-wrap: balance;
  }
  .summary {
    max-inline-size: 48ch;
    font: var(--t-hero-sub);
    letter-spacing: var(--ls-hero-sub);
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr));
    gap: 12px;
  }
  .metric {
    display: grid;
    gap: 8px;
    padding: 18px 20px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-tile);
    background: var(--panel);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  dt {
    font: 500 10.5px / 1.3 var(--font-mono);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  dd {
    margin: 0;
    font: 700 19px / 1.25 var(--font-body);
    font-variant-numeric: tabular-nums;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
  }
</style>
