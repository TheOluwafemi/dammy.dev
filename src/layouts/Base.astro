---
import '../styles/global.css'
import { Font } from 'astro:assets'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import Sky from '../components/Sky.astro'
import Preloader from '../components/Preloader.astro'
import { bootScript, type SkyMode } from '../sky/bootstrap'

interface Props {
  title: string
  description: string
  /** Absolute path for the canonical URL; defaults to the current path. */
  path?: string
  /** Absolute or site-relative OG image. Omitted until per-page OG images land (plan Phase 3). */
  image?: { src: string; width: number; height: number; alt: string }
  type?: 'website' | 'article'
  /** Keep a page out of search results. */
  noindex?: boolean
  /** Extra structured data for this page (e.g. an Article). */
  jsonLd?: Record<string, unknown>
  /** 'home' is the living sky; every other page gets the pale 'lite' sky. */
  sky?: SkyMode
}

const DEFAULT_IMAGE = { src: '/og/home.png', width: 1200, height: 630, alt: 'Damilola Oluwafemi, software engineer' }
const { title, description, path = Astro.url.pathname, image = DEFAULT_IMAGE, type = 'website', noindex = false, jsonLd, sky = 'lite' } = Astro.props
// build.format 'file' makes build-time pathnames end in .html; canonicals must not.
const cleanPath = path.replace(/(?:\/index)?\.html$/, '') || '/'
const canonical = new URL(cleanPath, Astro.site).href
const imageUrl = image ? new URL(image.src, Astro.site).href : undefined

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Damilola Oluwafemi',
  url: 'https://dammy.dev',
  jobTitle: 'Software engineer',
  address: { '@type': 'PostalAddress', addressCountry: 'GB' },
  sameAs: [
    'https://github.com/TheOluwafemi',
    'https://www.npmjs.com/~dammyskillz_',
    'https://github.com/flaghoist',
    'https://linkedin.com/in/damilola-oluwafemi',
    'https://twitter.com/dammyskillz_',
  ],
}
---

<!doctype html>
<html lang="en-GB" data-ink="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Damilola Oluwafemi: writing" href="/rss.xml" />
    <meta name="theme-color" content="#1d2150" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Damilola Oluwafemi" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {imageUrl && image && (
      <>
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:width" content={String(image.width)} />
        <meta property="og:image:height" content={String(image.height)} />
        <meta property="og:image:alt" content={image.alt} />
      </>
    )}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    <!-- Preload what the first screen paints: Bricolage (cloud and headings), Figtree 400 and 500
         (body, hero line), DM Mono 500 (labels). Figtree 600/700 and DM Mono 400 load on demand. -->
    <Font cssVariable="--font-bricolage" preload />
    <Font cssVariable="--font-figtree" preload={[{ weight: 400 }, { weight: 500 }]} />
    <Font cssVariable="--font-dm-mono" preload={[{ weight: 500 }]} />

    <!-- Blocking, before first paint: picks the sky and ink from the visitor's clock (src/sky/core.js). -->
    <script is:inline set:html={bootScript(sky)} />

    <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
  </head>
  <body>
    <Sky mode={sky} />
    {sky === 'home' && <Preloader />}
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <p class="visually-hidden" role="status" data-copy-status></p>
    <script>
      import '../scripts/copy'
    </script>
  </body>
</html>

