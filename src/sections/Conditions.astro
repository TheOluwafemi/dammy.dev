---
import { conditions } from '../data/site'
import { getPackages, summarise } from '../lib/npm'

const all = summarise(await getPackages())
// 7,212 -> "7.2k". Omitted (shown as a dash) if npm was unreachable at build time.
const compact = (n: number) => (n >= 1000 ? `${Math.round(n / 100) / 10}k` : String(n))

const items = [
  { label: 'Conditions', ...conditions.building },
  { label: 'Pressure', value: all.downloads === null ? '—' : compact(all.downloads), note: 'downloads a month' },
  { label: 'Fronts', value: String(all.count), note: 'packages on npm' },
  { label: 'Visibility', ...conditions.visibility },
]
---

<section class="conditions" aria-label="Conditions">
  <dl class="container grid">
    {items.map((i) => (
      <div class="item">
        <dt>{i.label}</dt>
        <dd class="value">{i.value}</dd>
        <dd class="note">{i.note}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .conditions {
    border-block: 1px solid var(--rule);
    background: var(--band);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition:
      background-color var(--dur-skin),
      border-color var(--dur-skin);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
  }
  .item {
    padding: 28px 24px 26px;
    border-inline-end: 1px solid var(--rule);
  }
  .item:first-child {
    padding-inline-start: 0;
  }
  .item:last-child {
    padding-inline-end: 0;
    border-inline-end: 0;
  }
  dt {
    font: var(--t-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
  }
  dd {
    margin: 0;
  }
  .value {
    margin-block-start: 12px;
    font: var(--t-cond-value);
    letter-spacing: var(--ls-cond-value);
    font-variant-numeric: tabular-nums;
  }
  .note {
    margin-block-start: 10px;
    font: 500 14px / 1.45 var(--font-body);
  }
  /* One column on phones: rules become row separators (spec §4.12). */
  @media (max-width: 639px) {
    .item,
    .item:first-child,
    .item:last-child {
      padding: 22px 0;
      border-inline-end: 0;
      border-block-end: 1px solid var(--rule);
    }
    .item:last-child {
      border-block-end: 0;
    }
  }
</style>
