---
// Spec §4.3. The headline is cloud drawn by the sky shader; the <h1> is the real text. It is
// visually hidden only while the shader is drawing it (not without JS or WebGL).
---

<section class="hero" data-sky-hero aria-labelledby="hero-title">
  <div class="container hero-inner">
    <p class="eyebrow" data-hero-sky>The sky follows your local time</p>
    <h1 id="hero-title" class="hero-title">I build developer tools</h1>
    <div class="hero-block">
      <p class="hero-sub">Eight years in banking, fintech and crypto. Now building Flaghoist, open-source feature flags.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#work">See my work</a>
        <a class="btn btn-outline" href="#contact">Contact me</a>
      </div>
    </div>
    <p class="scroll-hint" aria-hidden="true">
      Scroll to explore
      <svg viewBox="0 0 10 14" width="9" height="12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 1v11M1.5 8.5 5 12l3.5-3.5" /></svg>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
  }
  .hero-inner {
    position: relative;
    min-block-size: max(620px, calc(100svh - var(--header-h)));
    padding-block: 28px 72px;
    text-align: center;
  }
  .eyebrow {
    font: var(--t-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
  }
  /* No JS or no WebGL: a real headline in the flow. */
  .hero-title {
    margin-block: clamp(48px, 12vh, 140px) 0;
    font: 800 clamp(56px, 9vw, 130px) / 0.94 var(--font-display);
    letter-spacing: -0.045em;
    text-shadow: var(--glow);
  }
  .hero-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(18px, 3vh, 28px);
    margin-block-start: clamp(22px, 4vh, 40px);
  }
  /* With the shader drawing the headline: hide the h1 visually and pin the block under the cloud text. */
  :global(:root[data-js]:not([data-no-gl])) .hero-title {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* Mirrors src/sky/cloudText.ts: the cloud's last line ends at baseline + 0.26 × size, with
     size = min(8.2vw, 15vh, 130px) and baseline 32vh + 0.94 × size (two lines) on desktop,
     or size = min(15vw, 8.5vh) and baseline 30vh + 2 × 0.94 × size (three lines) on phones.
     The canvas is the viewport, so subtract the header above the hero. */
  :global(:root[data-js]:not([data-no-gl])) .hero-block {
    --cloud: min(8.2vw, 15vh, 130px);
    position: absolute;
    inset-block-start: calc(32vh + 1.2 * var(--cloud) - var(--header-h) + max(22px, 4vh));
    inset-inline: var(--gutter);
    margin: 0;
  }
  @media (max-width: 639px) {
    :global(:root[data-js]:not([data-no-gl])) .hero-block {
      --cloud: min(15vw, 8.5vh);
      inset-block-start: calc(30vh + 2.14 * var(--cloud) - var(--header-h) + max(22px, 4vh));
    }
  }
  .hero-sub {
    max-inline-size: 36ch;
    font: var(--t-hero-sub);
    text-wrap: balance;
    letter-spacing: var(--ls-hero-sub);
    text-shadow: var(--glow);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 12px;
  }
  .scroll-hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    position: absolute;
    inset-block-end: 28px;
    inset-inline: var(--gutter);
    font: var(--t-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
  }
</style>

<script>
  import { skyClock } from '../sky/core.js'
  import { heroPhase } from '../sky/time'

  const eyebrow = document.querySelector<HTMLElement>('[data-hero-sky]')

  function update() {
    const now = skyClock(location.search)
    const phase = heroPhase(now.getHours() + now.getMinutes() / 60)
    if (eyebrow) eyebrow.textContent = `${phase[0].toUpperCase()}${phase.slice(1)} where you are`
  }
  update()
  setInterval(update, 30_000)
</script>
