---
import SectionHead from '../components/SectionHead.astro'
import PostCards from '../components/PostCards.astro'
import { getPosts } from '../lib/writing'

const posts = (await getPosts()).slice(0, 3)
---

<section id="writing" class="writing container" data-sky-time="18:30" aria-labelledby="writing-title">
  <SectionHead left="18:30 · Dusk" name="Writing" />
  <h2 id="writing-title" class="section-xl">Writing</h2>
  <PostCards posts={posts} />
  <p class="more"><a class="link" href="/writing">All writing</a></p>
</section>

<style>
  .writing {
    padding-block: 12vh;
  }
</style>
