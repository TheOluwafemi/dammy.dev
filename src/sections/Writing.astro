---
import SectionHead from '../components/SectionHead.astro'
import { getPosts } from '../lib/writing'

const posts = (await getPosts()).slice(0, 3)
---

<section id="writing" class="writing container" data-sky-time="18:30" aria-labelledby="writing-title">
  <SectionHead time="18:30" phase="Dusk" name="Writing" />
  <h2 id="writing-title" class="section-xl">Writing</h2>

  <ol role="list" class="cards">
    {posts.map((p, i) => (
      <li class:list={['card', i === 0 && 'lead']}>
        <a href={`/writing/${p.id}`}>
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="text">
            <span class="title">{p.data.title}</span>
            <span class="summary">{p.data.summary}</span>
          </span>
        </a>
      </li>
    ))}
  </ol>
  <p class="all"><a class="link" href="/writing">All writing</a></p>
</section>

<style>
  .writing {
    padding-block: 12vh;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 14px;
  }
  .card a {
    display: grid;
    gap: 14px;
    align-content: space-between;
    block-size: 100%;
    min-block-size: 260px;
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    background: var(--panel);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    text-decoration: none;
    transition:
      transform 0.3s var(--ease-lift),
      background-color var(--dur-skin),
      border-color var(--dur-skin);
  }
  @media (hover: hover) and (pointer: fine) {
    .card a:hover {
      transform: translateY(-3px);
    }
  }
  .lead {
    grid-column: 1 / -1;
  }
  .lead a {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 18px 40px;
    align-items: end;
    min-block-size: 0;
    padding: clamp(22px, 3.5vw, 40px);
  }
  .num {
    font: 800 56px / 0.8 var(--font-display);
    letter-spacing: -0.05em;
  }
  .lead .num {
    font: var(--t-writing-num-lead);
    letter-spacing: var(--ls-writing-num-lead);
  }
  .text {
    display: grid;
    gap: 10px;
  }
  .title {
    font: var(--t-writing-card);
    letter-spacing: var(--ls-writing-card);
  }
  .lead .title {
    font: var(--t-writing-lead);
    letter-spacing: var(--ls-writing-lead);
  }
  .summary {
    font: 400 15px / 1.5 var(--font-body);
  }
  .lead .summary {
    font-size: 16px;
    line-height: 1.55;
  }
  .all {
    margin-block-start: 28px;
    font: 600 15px / 1 var(--font-body);
  }
</style>
