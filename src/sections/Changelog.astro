---
import SectionHead from '../components/SectionHead.astro'
import { releases, TAGS, releaseId } from '../data/changelog'

const selected = releases.find((r) => r.version !== 'Unreleased') ?? releases[0]
---

<section id="changelog" class="changelog container" data-sky-time="16:00" aria-labelledby="changelog-title">
  <SectionHead name="Changelog" />
  <h2 id="changelog-title" class="section-xl">Changelog</h2>

  <div class="panel" data-changelog>
    <p class="intro">All notable changes to Damilola Oluwafemi. Major version = years in the industry. The learning years ship as 0.x.</p>

    <div class="controls">
      <nav class="chips" aria-label="Versions">
        {releases.map((r) => (
          <a
            class="chip"
            href={`#${releaseId(r.version)}`}
            data-version={r.version}
            aria-current={r === selected ? 'true' : undefined}
          >
            {r.version}
          </a>
        ))}
      </nav>
      <ul role="list" class="legend" aria-label="Change types">
        {TAGS.map((t) => (
          <li><span class={`swatch tag-${t}`} aria-hidden="true"></span>{t}</li>
        ))}
      </ul>
    </div>

    <ol role="list" class="releases">
      {releases.map((r) => (
        <li id={releaseId(r.version)} class="release" data-selected={r === selected ? '' : undefined}>
          <div class="version">
            <h3>{r.version}</h3>
            <p class="date">{r.date}</p>
          </div>
          <ul role="list" class="items">
            {r.items.map(([tag, text]) => (
              <li>
                <span class={`tag tag-${tag}`}>{tag}</span>
                <span>{text}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .changelog {
    padding-block: 12vh;
  }
  /* Always light, whatever the sky (spec §3.4). */
  .panel {
    padding: clamp(22px, 3.5vw, 48px);
    border: 1px solid var(--paper-rule);
    border-radius: var(--radius-panel);
    background: var(--paper);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    box-shadow: 0 30px 90px rgba(20, 20, 60, 0.2);
    color: var(--paper-ink);
    --accent: #2f5fd0; /* focus ring on the light panel, whatever the ink */
  }
  .intro {
    max-inline-size: 34ch;
    font: 500 clamp(19px, 2vw, 26px) / 1.4 var(--font-body);
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
    margin-block-start: 28px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
    padding-inline: 16px;
    border: 1px solid rgba(23, 19, 29, 0.18);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.7);
    color: var(--paper-ink);
    font: 600 12.5px / 1 var(--font-mono);
    text-decoration: none;
    transition:
      transform 0.2s var(--ease-lift),
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .chip[aria-current] {
    border-color: var(--paper-ink);
    background: var(--paper-ink);
    color: #fffaf4;
  }
  @media (hover: hover) and (pointer: fine) {
    .chip:hover {
      transform: translateY(-2px) rotate(-1.5deg);
    }
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    font: 500 11.5px / 1 var(--font-mono);
    color: var(--paper-ink-muted);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .swatch {
    inline-size: 10px;
    block-size: 10px;
    border: 1px solid currentColor;
    border-radius: 3px;
  }
  .releases {
    margin-block-start: 26px;
  }
  .release {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 40px;
    margin-inline: -18px;
    padding: clamp(22px, 3.5vh, 34px) 18px;
    border-block-start: 1px solid var(--paper-rule);
    border-radius: 18px;
    scroll-margin-block-start: 90px;
    transition: background-color 0.5s var(--ease);
  }
  .release[data-selected] {
    background: rgba(255, 214, 102, 0.2);
  }
  .version {
    flex: 1 1 220px;
  }
  .version h3 {
    font: var(--t-release-version);
    letter-spacing: var(--ls-release-version);
  }
  .date {
    margin-block-start: 10px;
    font: 500 12.5px / 1 var(--font-mono);
    color: var(--paper-ink-muted);
  }
  .items {
    display: grid;
    flex: 3 1 380px;
    align-content: center;
    gap: 14px;
    min-inline-size: 0;
  }
  .items li {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font: 400 clamp(16px, 1.5vw, 19px) / 1.5 var(--font-body);
  }
  .tag {
    flex: none;
    inline-size: 78px;
    padding-block: 5px;
    border-radius: 8px;
    font: 600 11px / 1 var(--font-mono);
    text-align: center;
  }
  .tag-planned {
    background: var(--tag-planned-bg);
    color: var(--tag-planned-fg);
  }
  .tag-feat {
    background: var(--tag-feat-bg);
    color: var(--tag-feat-fg);
  }
  .tag-breaking {
    background: var(--tag-breaking-bg);
    color: var(--tag-breaking-fg);
  }
  .tag-docs {
    background: var(--tag-docs-bg);
    color: var(--tag-docs-fg);
  }
  .tag-chore {
    background: var(--tag-chore-bg);
    color: var(--tag-chore-fg);
  }
  .swatch.tag-planned {
    color: var(--tag-planned-fg);
  }
  .swatch.tag-feat {
    color: var(--tag-feat-fg);
  }
  .swatch.tag-breaking {
    color: var(--tag-breaking-fg);
  }
  .swatch.tag-docs {
    color: var(--tag-docs-fg);
  }
  .swatch.tag-chore {
    color: var(--tag-chore-fg);
  }
</style>

<script>
  // Chips are links, so without JS they still jump to the release. With JS they also select it:
  // highlight the row, then scroll.
  const panel = document.querySelector<HTMLElement>('[data-changelog]')
  if (panel) {
    panel.addEventListener('click', (e) => {
      const chip = (e.target as Element).closest<HTMLAnchorElement>('a[data-version]')
      if (!chip) return
      e.preventDefault()
      panel.querySelectorAll('a[data-version]').forEach((c) => (c === chip ? c.setAttribute('aria-current', 'true') : c.removeAttribute('aria-current')))
      const target = document.querySelector<HTMLElement>(chip.getAttribute('href')!)
      panel.querySelectorAll('.release').forEach((r) => r.toggleAttribute('data-selected', r === target))
      target?.scrollIntoView({ block: 'start' })
      history.replaceState(null, '', chip.getAttribute('href'))
    })
  }
</script>
