---
import SectionHead from '../components/SectionHead.astro'
import WorkBoard from '../components/WorkBoard.astro'
import { getFeatured } from '../lib/work'

const rows = (await getFeatured()).slice(0, 4)
---

<section id="work" class="work container" data-sky-time="12:10" aria-labelledby="work-title">
  <SectionHead name="Work" />
  <h2 id="work-title" class="section-xl">The work</h2>
  <WorkBoard rows={rows} />
  <p class="more"><a class="link" href="/work">See all work</a></p>
</section>

<style>
  .work {
    padding-block: 10vh 12vh;
  }
</style>
